{
  "name": "rest-api",
  "version": "0.1.0",
  "description": "Simple CRUD API with in-memory storage",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "start:dev": "tsx watch src/index.ts",
    "start:prod": "npm run build && node dist/index.js",
    "start:multi": "npm run build && node dist/clusterSimple.js",
    "build": "tsc --project tsconfig.json",
    "dev": "npm run start:dev",
    "test": "NODE_OPTIONS=--experimental-vm-modules jest --detectOpenHandles"
  },
  "engines": {
    "node": ">=24.10.0"
  },
  "dependencies": {
    "dotenv": "^17.2.3",
    "uuid": "^9.0.1"
  },
  "devDependencies": {
    "@types/jest": "^30.0.0",
    "@types/node": "^22.19.0",
    "@types/supertest": "^6.0.3",
    "@types/uuid": "^9.0.8",
    "jest": "^30.2.0",
    "supertest": "^7.1.4",
    "ts-jest": "^29.4.5",
    "ts-node-dev": "^2.0.0",
    "tsx": "^4.20.6",
    "typescript": "^5.9.3"
  }
}
